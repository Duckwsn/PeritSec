# Copie para .env e troque a senha antes de iniciar o PostgreSQL.
POSTGRES_DB=peritsec
POSTGRES_USER=peritsec
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_PORT=5432

# A senha precisa corresponder a POSTGRES_PASSWORD.
DATABASE_URL=postgres://peritsec:troque-esta-senha-local@127.0.0.1:5432/peritsec
PERITSEC_DB_CONNECT_ATTEMPTS=15
